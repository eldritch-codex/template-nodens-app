// See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "NodensApp CMake: Config Debug",
    "command": "cmake",
    "args": [
      "-B",
      "build",
      "-S",
      ".",
      "-DCMAKE_BUILD_TYPE=Debug",
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "NodensApp CMake: Config Release",
    "command": "cmake",
    "args": [
      "-B",
      "build",
      "-S",
      ".",
      "-DCMAKE_BUILD_TYPE=Release",
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "NodensApp CMake: Build",
    "command": "cmake --build build",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
